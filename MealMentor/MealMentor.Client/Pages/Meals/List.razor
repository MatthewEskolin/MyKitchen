@page "/Meals/list"
@inject HttpClient _http;
@using System.Diagnostics
@using MealMentor.Shared.DTO
@using Radzen.Blazor

<h3>List</h3>

@* Create Grid of Meals*@

@* Style with blue and white theme *@
 <style type="text/css">
    .table {
        width: 100%;
        margin-bottom: 1rem;
        color: #212529;
        background-color: #e9ecef;
        border-collapse: collapse;
    }

    .table th,
    .table td {
        padding: 0.75rem;
        vertical-align: top;
        border-top: 1px solid #dee2e6;
    }

    .table thead th {
        vertical-align: bottom;
        border-bottom: 2px solid #dee2e6;
    }

    .table tbody+tbody {
        border-top: 2px solid #dee2e6;
    }

    .radzen-grid {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .radzen-grid-header {
        background-color: #007bff;
        color: white;
        font-weight: bold;
        text-align: left;
        padding: 10px;
    }

    .radzen-grid-cell {
        padding: 10px;
        border-bottom: 1px solid #ddd;
    }

    .radzen-grid-row:hover {
        background-color: #f1f1f1;
    }

    .radzen-grid-footer {
        background-color: #f8f9fa;
        padding: 10px;
        text-align: right;
    }

    .radzen-button {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.3s;
    }

        .radzen-button:hover {
            background-color: #0056b3;
        }
</style> 





@if (mealsLoaded)
{
    <RadzenDataGrid @ref="_grid" Data="@_meals" TItem="MealDTO" RowSelect="EditMealRad" class="radzen-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MealDTO" Property="mealID" Title="Meal ID"  />
            <RadzenDataGridColumn TItem="MealDTO" Property="name" Title="Meal Name" />
            <RadzenDataGridColumn TItem="MealDTO" Property="Comments" Title="Meal Description" />
        </Columns>
        <FooterTemplate>
            <div class="radzen-grid-footer">
                <button class="radzen-button">Add New Meal</button>
            </div>
        </FooterTemplate>
    </RadzenDataGrid>
}
else
{
    @:Loading...
}
@code {

    private List<MealDTO> _meals = [];
    RadzenDataGrid<MealDTO> _grid;

    public bool mealsLoaded = false;

    protected override async Task OnInitializedAsync()
    {

        Debug.Assert(_http != null);

        var result = new List<MealDTO>();
        _meals = await _http.GetFromJsonAsync<List<MealDTO>>("api/getmeals") ?? result;

        if (_meals.Count == 0)
        {
            _meals = [new MealDTO { name = "Test Meal", IsFavorite = true, mealID = 0 }];
        }


        mealsLoaded = true;
    }

    protected override void OnParametersSet()
    {


    }

    private Task EditMealRad(MealDTO meal)
    {
        throw new NotImplementedException();
    }

    private Task EditMeal(int mealMealID)
    {
        throw new NotImplementedException();
    }


}
