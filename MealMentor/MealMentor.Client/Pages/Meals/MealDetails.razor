@page "/Meals/details/{MealId:int}"
@using MealMentor.Client.State
@using MealMentor.Shared.API
@inject MealMentorAPIClient Client 
@inject NavigationManager Navigation
@inject NotificationState NotificationService


<style type="text/css">
    .editImage {
        height: 35px;
        width: 35px;
    }
</style>
@if (_meal == null)
{
    <p>Loading...</p>
}
else
{
    <div class="container mt-5">
        @if (_editMealMode)
        {
            <div class="page-header mb-4">
                <div class="float-left">
                    <EditForm Model="@_meal" OnValidSubmit="@SaveMealName">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="input-group mb-3">
                            <input @bind="_meal.Name" type="text" class="form-control" placeholder="Meal Name" />
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-success">Save</button>
                                <button type="button" class="btn btn-secondary ml-2" @onclick="CancelEditMealName">Cancel</button>
                            </div>
                        </div>
                    </EditForm>
                </div>
                <div class="clearfix"></div>
            </div>
        }
        else
        {
            <div class="page-header mb-4">
                <div class="float-left">
                    <h2 class="text-primary">@_meal.Name</h2>
                </div>
                <div class="float-left ml-3">
                    <button class="btn btn-link p-0" @onclick="EditMealName">
                        <img class="editImage" src="images/editpencil_120034.png" />
                    </button>
                </div>
                <div class="clearfix"></div>
            </div>
        }

        <hr />
        <div class="mb-4">
            <button class="btn btn-primary mr-2" @onclick="AddToQueue">Queue</button>
            <button class="btn btn-danger" @onclick="DeleteMeal">Delete Meal</button>
        </div>

        <EditForm Model="@_meal" OnValidSubmit="@UpdateMeal">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-group">
                <label for="recipe" class="font-weight-bold">Recipe</label>
                <textarea id="recipe" @bind="_meal.Recipe" class="form-control w-75" rows="12" placeholder="Enter the recipe here..."></textarea>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-success mr-2">Save</button>
                <button type="button" class="btn btn-secondary" @onclick="NavigateBack">Back</button>
            </div>
        </EditForm>

        <h5 class="mt-5">Upload Images</h5>

        <InputFile OnChange="UploadFiles" multiple class="mb-3" />

        <div id="_ImageList" class="d-flex flex-wrap">
            @foreach (var image in _mealImages)
            {
                <div class="m-2">
                    <img src="@image.ImagePath" alt="Image" class="img-thumbnail" style="max-width: 150px;" />
                </div>
            }
        </div>
    </div>
    }

    @code {

        [Parameter] public int MealId { get; set; }

        private MealDTO? _meal;

        private List<MealImageDTO>? _mealImages;

        private bool _editMealMode;

        protected override async Task OnInitializedAsync()
        {
            NotificationService.ShowPendingMessages();
    
            await LoadMealDetails();
        }

        private async Task LoadMealDetails()
        {
            var mealResult = await Client.GetMeal(MealId);

            if (mealResult != null)
            {
                _meal = mealResult;
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to load meal details");
            }

            var imageResult = await Client.GetImages(MealId);

            if (imageResult != null)
            {
                _mealImages = imageResult;
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to load meal images");
            }

        }

        private void EditMealName()
        {
            _editMealMode = true;
        }

        private void CancelEditMealName()
        {
            _editMealMode = false;
        }

        private async Task SaveMealName()
        {
            if (_meal.MealID == null)
            {
                throw new InvalidOperationException("Missing MealID");
            }

            var result = await Client.UpdateMealName(_meal.MealID.Value, _meal.Name);

            if (result)
            {
                _editMealMode = false;
            }
        }

        private async Task UpdateMeal()
        {
            var response = await Client.UpdateMeal(_meal);

        }

        private void AddToQueue()
        {
            // Implement Add to Queue logic
        }

        private async Task DeleteMeal()
        {
            if (_meal.MealID == null)
            {
                throw new InvalidOperationException("Missing MealID");
            }

            var response = await Client.DeleteMeal(_meal.MealID.Value);

            if (response)
            {
                Navigation.NavigateTo("/Meals/list");
            }
        }

        private async Task DeleteFoodItemFromMeal(int mealFoodItemId)
        {
            await Task.CompletedTask;
            // if (_meal.MealID == null)
            // {
            //     throw new InvalidOperationException("Missing MealID");
            // }

            // var response = await Client.DeleteFoodItems(mealId,mealFoodItemId);
            // if (response)
            // {
            //     await LoadMealDetails();
            // }
        }

        private void NavigateBack()
        {
            Navigation.NavigateTo("/Meals/list");
        }

        private async Task UploadFiles(InputFileChangeEventArgs e)
        {
            foreach (var file in e.GetMultipleFiles())
            {
                var content = new MultipartFormDataContent();
                content.Add(new StreamContent(file.OpenReadStream()), "files", file.Name);
                content.Add(new StringContent(_meal.MealID.ToString()), "MealID");

                var response = await Client.UploadFile(content);//Http.PostAsync("/MealBuilder/UploadFile", content);
                if (response)
                {
                    _mealImages = await Client.GetImages(_meal.MealID.Value);
                }
            }
        }
    }